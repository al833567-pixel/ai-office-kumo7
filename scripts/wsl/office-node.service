# systemd 使用者服務（WSL 需先在 /etc/wsl.conf 開啟 [boot] systemd=true）
# 安裝：
#   mkdir -p ~/.config/systemd/user
#   sed "s#@PROJECT@#$HOME/ai-office-kumo7#" scripts/wsl/office-node.service > ~/.config/systemd/user/office-node.service
#   systemctl --user daemon-reload && systemctl --user enable --now office-node
#   loginctl enable-linger "$USER"   # 沒有登入 WSL 也常駐
[Unit]
Description=AI Office node (Hermes bridge)
After=network-online.target

[Service]
WorkingDirectory=@PROJECT@
ExecStart=/usr/bin/env bash @PROJECT@/scripts/wsl/run-office-node.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
